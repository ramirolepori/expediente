{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expediente",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-H",
        "0.0.0.0"
      ],
      "port": 3000
    },
    {
      "name": "expediente-autores-falso",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-p",
        "3002"
      ],
      "port": 3002,
      "env": {
        "AUTH_FALSO": "1",
        "ADMIN_EMAILS": "admin@prueba.test",
        "NEXT_DIST_DIR": ".next-falso"
      }
    }
  ]
}