# Copiar a .env.local y completar. Nunca subir .env.local al repo.

# Clave gratuita de Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional: modelo a usar para los interrogatorios
# MODELO_LLM=gemini-3.1-flash-lite
# MODELO_LLM_RESPALDO=gemini-3.5-flash

# Supabase (Project Settings → API Keys / Data API). Sin estas, las salas viven en memoria (solo local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cuentas de autor (ADR 0012): mails de los administradores, separados por coma
# ADMIN_EMAILS=

# Solo tests y desarrollo sin Supabase: login de autores falso (nunca funciona en Vercel)
# AUTH_FALSO=1
